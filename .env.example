# Canonical site origin, without a trailing slash. Used for canonical URLs,
# hreflang, sitemap, robots and Open Graph metadata.
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL, so it only needs
# setting explicitly for a custom domain.
SITE_URL=http://localhost:3000

# Optional — contact form delivery. When absent, the form falls back to mailto.
RESEND_API_KEY=

# Optional — GitHub section, avoids rate limits (Phase 4).
GITHUB_TOKEN=
